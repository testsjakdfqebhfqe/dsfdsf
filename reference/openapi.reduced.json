{
  "openapi": "3.1.0",
  "info": {
    "title": "3rd party odds",
    "description": "A self service API based platform for onboarding an external partner (providing specialized precomputed odds), ingesting the odds and forwarding it to bookmakers via UOF.<p>&copy; Sportradar Copyright.<br/>Only logged-in users are allowed to access it. Do not share it with unauthorized users.</p>",
    "version": "1.0.0"
  },
  "x-readme": {
    "samples-languages": [
      "shell",
      "node",
      "java",
      "python",
      "csharp"
    ]
  },
  "tags": [
    {
      "name": "Send Odds"
    }
  ],
  "servers": [
    {
      "url": "https://api.partner.dev.odds-prod.sportradar.com/v1",
      "description": "Sandbox environment"
    }
  ],
  "paths": {},
  "components": {
    "parameters": {
      "sportEventId": {
        "name": "sport_event_id",
        "description": "The sport event identifier. Supported formats: sr:match:123, sr:stage:123, codds:competition_group:123",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "product": {
        "name": "product",
        "description": "Product type: liveodds for inplay, pre for prematch, codds for competition odds.",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "enum": [
            "pre",
            "liveodds",
            "codds"
          ],
          "default": "liveodds"
        }
      },
      "partner_id": {
        "name": "partner_id",
        "description": "ID of the partner providing specialized odds.",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "default": "sportradar"
        }
      }
    },
    "responses": {
      "AcceptedForProcessing": {
        "description": "Accepted for processing",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "statusCode": {
                  "type": "integer",
                  "example": 202
                },
                "status": {
                  "type": "string",
                  "example": "Accepted"
                },
                "requestTimestamp": {
                  "type": "integer",
                  "example": 1747215946606
                }
              }
            }
          }
        }
      },
      "InvalidRequestBody": {
        "description": "Invalid request body",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "message": {
                  "type": "string",
                  "example": "Invalid request body"
                }
              }
            }
          }
        }
      }
    },
    "securitySchemes": {
      "token": {
        "type": "oauth2",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://auth.sportradar.com/oauth/token",
            "scopes": {}
          }
        }
      }
    }
  },
  "security": [
    {
      "token": []
    }
  ]
}