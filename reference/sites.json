{
  "openapi": "3.0.3",
  "info": {
    "title": "OAuth2 authorization-code debug API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://489c-185-70-55-157.ngrok-free.app"
    }
  ],
  "x-readme": {
    "oauth-options": {
      "useInsecureClientAuthentication": true,
      "usePkce": true
    }
  },
  "paths": {
    "/api/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Protected — echoes the token it was called with",
        "security": [
          {
            "OAuth2": [
              "api.read"
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "OAuth2": {
        "type": "oauth2",
        "flows": {
          "authorizationCode": {
            "x-readme": {
              "proxy-enabled": true
            },
            "authorizationUrl": "https://489c-185-70-55-157.ngrok-free.app/oauth/authorize",
            "tokenUrl": "https://489c-185-70-55-157.ngrok-free.app/oauth/token",
            "scopes": {
              "api.read": "Read data from the API"
            }
          }
        }
      }
    }
  }
}