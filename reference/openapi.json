{
  "openapi": "3.1.0",
  "info": {
    "version": "2.0.0",
    "title": "Account API"
  },
  "servers": [
    {
      "url": "https://api.kubra.io/account/v2"
    }
  ],
  "x-readme": {
    "oauth-options": {
      "scopeSeparator": ",",
      "useInsecureClientAuthentication": true,
      "usePkce": true
    }
  },
  "security": [
    {
      "MachineToken1": []
    },
    {
      "StaffToken": []
    },
    {
      "ConsumerToken": []
    }
  ],
  "paths": {
    "/accounts/{accountKrn}": {
      "get": {
        "summary": "Get account",
        "description": "Retrieve account information using the account KRN.\n## Access Control\nAny of the following allow access:\n- requester has the `acct:account:r` permission for the client-realm\n  that contains this account\n\n- A relationship links the requester to this account (for example,\n  consumer-to-account)",
        "operationId": "getAccount",
        "parameters": [
          {
            "name": "accountKrn",
            "in": "path",
            "required": true,
            "description": "The KRN of the account to retrieve",
            "schema": {
              "type": "string",
              "format": "Krn"
            }
          },
          {
            "name": "excludeBalance",
            "in": "query",
            "required": false,
            "description": "Set to true to exclude balance information from the response",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Account"
                }
              }
            }
          },
          "404": {
            "description": "Account not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResp"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResp"
                }
              }
            }
          },
          "5XX": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResp"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "MachineToken1": {
        "type": "oauth2",
        "description": "Machine-to-machine token issued to backend services, obtained with the OAuth 2.0 Client Credentials Grant.",
        "flows": {
          "clientCredentials": {
            "tokenUrl": "https://api.io/authentication/api/v2/token",
            "scopes": {
              "account:r": "Read access to accounts",
              "account:w": "Write access to accounts"
            }
          }
        }
      },
      "StaffToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token issued to KUBRA or client staff."
      },
      "ConsumerToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Bearer token issued to an end consumer."
      }
    },
    "schemas": {
      "Account": {
        "title": "Account",
        "description": "An account represents the ongoing relationship between a client and a consumer.",
        "allOf": [
          {
            "$ref": "#/components/schemas/AccountProto"
          },
          {
            "type": "object",
            "properties": {
              "krn": {
                "type": "string",
                "format": "Krn",
                "description": "The KRN of the account"
              },
              "lastBillAmount": {
                "description": "The balance amount from the last bill for this account",
                "type": [
                  "string",
                  "null"
                ]
              },
              "balanceLastUpdatedAtSourceDate": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date-time",
                "description": "The last update date of the balance for this account"
              },
              "consumerSettings": {
                "$ref": "#/components/schemas/ConsumerSettings",
                "description": "Consumer preferences for this account"
              },
              "warnings": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "$ref": "#/components/schemas/Warning"
                },
                "description": "Warnings associated with this account response"
              },
              "revision": {
                "type": "integer",
                "description": "The revision number of this account"
              },
              "lookupFields": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/extensionFieldValue"
                },
                "description": "Additional fields for lookup purposes"
              },
              "extensionFields": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/components/schemas/extensionFieldValue"
                },
                "description": "Client-defined extension field values for this account"
              }
            },
            "required": [
              "krn",
              "typeKrn",
              "spaceKrn",
              "accountNumber",
              "feeClass",
              "consumerSettings",
              "revision"
            ]
          }
        ]
      },
      "Address": {
        "type": "object",
        "properties": {
          "streetAddress": {
            "type": "string",
            "description": "The first line of the mailing address"
          },
          "locality": {
            "type": "string",
            "description": "The smallest area containing the address, usually a city"
          },
          "region": {
            "type": "string",
            "description": "The state or province of the mailing address"
          },
          "postalCode": {
            "type": "string",
            "description": "The postal code of the mailing address"
          },
          "country": {
            "type": "string",
            "format": "iso-3166-1-alpha-3",
            "description": "The country code of the mailing address (ISO 3166-1 alpha-3)"
          }
        }
      },
      "ConsumerSettings": {
        "type": "object",
        "description": "Consumer preferences for account communication",
        "properties": {
          "sendPaperComms": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Whether the consumer prefers to receive paper communications"
          }
        },
        "required": []
      },
      "AccountProto": {
        "title": "AccountProto",
        "description": "Client-provided account fields used when creating or updating an account.",
        "type": "object",
        "properties": {
          "typeKrn": {
            "type": "string",
            "format": "Krn",
            "description": "The KRN for the type of this account"
          },
          "spaceKrn": {
            "type": "string",
            "format": "Krn",
            "description": "The KRN of the space this account belongs to"
          },
          "businessUnitCode": {
            "type": "string",
            "description": "The code of the business unit this account belongs to"
          },
          "feeClass": {
            "enum": [
              "A",
              "B",
              "C",
              "D",
              "E"
            ],
            "description": "The fee class of this account"
          },
          "externalId": {
            "type": "string",
            "description": "The external ID of this account"
          },
          "externalRevision": {
            "type": [
              "integer",
              "null"
            ],
            "description": "The revision number of this account in the external source system. When provided on update, it must be greater than the existing revision."
          },
          "messageCodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The message codes for this account"
          },
          "fundingRestrictions": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "BankAccount",
                    "Card"
                  ]
                },
                {
                  "type": "string"
                }
              ]
            },
            "description": "The funding restrictions for this account. Known values are `BankAccount` and `Card`"
          },
          "dueDate": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The due date of the balance for this account"
          },
          "payableAmount": {
            "type": [
              "string",
              "null"
            ],
            "description": "The current balance for this account"
          },
          "minimumPayment": {
            "type": [
              "string",
              "null"
            ],
            "description": "The minimum amount due of the balance for this account"
          },
          "passThrough": {
            "type": [
              "string",
              "null"
            ],
            "description": "Arbitrary information that will be attached to payments made to this account"
          },
          "accountNumber": {
            "type": "string",
            "description": "The account number of this account"
          },
          "mailingAddress": {
            "$ref": "#/components/schemas/Address",
            "description": "The mailing address for this account"
          },
          "openedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "The date and time when this account was opened"
          }
        }
      },
      "extensionFieldValue": {
        "type": "object",
        "properties": {
          "value": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NonBlankText"
              },
              {
                "$ref": "#/components/schemas/Integer"
              },
              {
                "$ref": "#/components/schemas/Boolean"
              },
              {
                "$ref": "#/components/schemas/PhoneNumber"
              },
              {
                "$ref": "#/components/schemas/Email"
              },
              {
                "$ref": "#/components/schemas/Date"
              },
              {
                "$ref": "#/components/schemas/DateTime"
              },
              {
                "$ref": "#/components/schemas/Address"
              },
              {
                "$ref": "#/components/schemas/SelectOne"
              },
              {
                "$ref": "#/components/schemas/SelectMany"
              },
              {
                "$ref": "#/components/schemas/DollarAmount"
              }
            ]
          },
          "type": {
            "type": "string",
            "description": "Type discriminator for this field's value"
          }
        },
        "required": [
          "value",
          "type"
        ]
      },
      "NonBlankText": {
        "type": "string",
        "description": "A non-blank text value"
      },
      "Integer": {
        "type": "number",
        "format": "int32",
        "description": "An integer value"
      },
      "Boolean": {
        "type": "boolean",
        "description": "A boolean value"
      },
      "PhoneNumber": {
        "type": "string",
        "format": "phoneNumber",
        "description": "A phone number value"
      },
      "Email": {
        "type": "string",
        "format": "email",
        "description": "An email address value"
      },
      "Date": {
        "type": "string",
        "format": "date",
        "description": "A date value"
      },
      "DateTime": {
        "type": "string",
        "format": "date-time",
        "description": "A date and time value"
      },
      "SelectOne": {
        "type": "string",
        "description": "A single selected option"
      },
      "SelectMany": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Multiple selected options"
      },
      "DollarAmount": {
        "type": "number",
        "multipleOf": 0.01,
        "description": "A dollar amount"
      },
      "Warning": {
        "type": "object",
        "description": "A warning message associated with the account response",
        "properties": {
          "code": {
            "type": "string",
            "description": "The warning code"
          },
          "message": {
            "type": "string",
            "description": "The warning message"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "Error": {
        "description": "Represents an error",
        "type": "object",
        "properties": {
          "code": {
            "description": "Error code",
            "type": "string"
          },
          "message": {
            "description": "Error message",
            "type": "string"
          },
          "target": {
            "description": "What about the request caused this error",
            "type": "object",
            "properties": {
              "type": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "field",
                      "parameter",
                      "krn",
                      "header",
                      "permission",
                      "internal_server_error"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ],
                "description": "The type of the input that caused this error. Known values include `field`, `parameter`, `krn`, `header`, `permission`, and `internal_server_error`"
              },
              "name": {
                "type": "string",
                "description": "The part of the request that caused the error"
              }
            }
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ErrorOnceRemoved"
            }
          }
        }
      },
      "ErrorResp": {
        "type": "object",
        "properties": {
          "trace": {
            "type": "string",
            "description": "Request trace ID"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Error"
            },
            "description": "List of errors"
          }
        }
      },
      "ErrorOnceRemoved": {
        "description": "Represents an Error. Same as Error but duplicated because some tools can't handle recursive types.",
        "type": "object",
        "properties": {
          "code": {
            "description": "Error code",
            "type": "string"
          },
          "message": {
            "description": "Error message",
            "type": "string"
          },
          "target": {
            "description": "What about the request caused this error",
            "type": "object",
            "properties": {
              "type": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "field",
                      "parameter",
                      "krn",
                      "header",
                      "permission",
                      "internal_server_error"
                    ]
                  },
                  {
                    "type": "string"
                  }
                ],
                "description": "The type of the input that caused this error. Known values include `field`, `parameter`, `krn`, `header`, `permission`, and `internal_server_error`; new values may be added over time."
              },
              "name": {
                "type": "string",
                "description": "The part of the request that caused the error"
              }
            }
          },
          "details": {
            "description": "Additional details about this error",
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}